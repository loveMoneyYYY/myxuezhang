* text=auto

# Keep source/config/docs in LF for cross-platform consistency.
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows script files keep CRLF for better shell compatibility.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
