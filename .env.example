# Remote PostgreSQL connection string.
# Keep the real value in the server environment; never commit it to Git.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Set to true when your database provider requires TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Keep the admin password outside config.json.
ADMIN_PASSWORD=change-this-password

# Use a private, hard-to-guess path for the administration page.
ADMIN_PATH=/qdbh-console-change-me

# Optional connection pool size.
DATABASE_POOL_MAX=10

# Optional persistent directory for uploaded images/PDF files.
# Relative paths are resolved from the project directory.
UPLOAD_DIR=public/uploads
